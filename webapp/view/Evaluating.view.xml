<mvc:View
    controllerName="srt.app.controller.Evaluating"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="evaluatingPage"
          title="{i18n>evaluatingTitle}"
          showNavButton="true"
          navButtonPress="onNavBack"
          class="srtPageHeaderBar">
        <content>
            <VBox class="sapUiMediumMargin">

                <SearchField id="searchField" placeholder="{i18n>searchPlaceholder}"
                             width="20rem" liveChange="onSearch" class="sapUiSmallMarginBottom" />

                <Table id="evaluatingTable" items="{evaluating>/items}" growing="true" growingThreshold="20">
                    <columns>
                        <Column><Text text="{i18n>colObject}" /></Column>
                        <Column><Text text="{i18n>colStatus}" /></Column>
                        <Column><Text text="{i18n>colDate}" /></Column>
                        <Column><Text text="{i18n>colMessage}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{evaluating>object}" />
                                <ObjectStatus text="{evaluating>status}" state="{evaluating>statusState}" />
                                <Text text="{evaluating>date}" />
                                <Text text="{evaluating>message}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>
