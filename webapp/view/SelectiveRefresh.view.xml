<mvc:View
    controllerName="srt.app.controller.SelectiveRefresh"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="selectiveRefreshPage"
        showHeader="false"
        enableScrolling="true"
        class="srtSelectivePage"
    >
        <content>
            <!-- ================= HEADER ================= -->
            

            <!-- ================= HERO ================= -->
            <VBox class="srtRefreshHero">
                <HBox
                    class="srtHeroContent"
                    alignItems="Center"
                >
                <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back"
                        press="onNavBack"
                        class="srtBackButton"
                    />
                    <VBox class="srtHeroDocumentIcon">
                        <core:Icon
                            src="sap-icon://document-text"
                            size="1.4rem"
                        />
                    </VBox>

                    <VBox class="srtHeroText">
                        <Title
                            text="Selective Refresh Tool"
                            level="H4"
                            class="srtHeroTitle"
                        />

                        <!-- <Text
                            text="Configure migration parameters and define"
                            class="srtHeroDescription"
                        /> -->

                        <!-- <Text
                            text="define selection criteria to refresh the required data."
                            class="srtHeroDescription"
                        /> -->
                    </VBox>

                    <ToolbarSpacer />

                    <!-- STEP INDICATOR
                    <HBox
                        class="srtStepContainer"
                        alignItems="Center"
                    >

                        <VBox
                            class="srtStepItem"
                            alignItems="Center"
                        >

                            <Text
                                text="1"
                                class="srtStepCircle srtStepActive"
                            />

                            <Text
                                text="Configure Parameters"
                                class="srtStepLabel srtStepLabelActive"
                            />

                        </VBox>

                        <VBox class="srtStepLine" />

                        <VBox
                            class="srtStepItem"
                            alignItems="Center"
                        >

                            <Text
                                text="2"
                                class="srtStepCircle srtStepInactive"
                            />

                            <Text
                                text="Review &amp; Execute"
                                class="srtStepLabel"
                            />

                        </VBox>

                    </HBox> -->
                </HBox>
            </VBox>

            <!-- ================= MIGRATION PARAMETERS ================= -->
            <VBox class="srtContentCard">
                <HBox
                    class="srtSectionTitleRow"
                    alignItems="Center"
                >
                    <core:Icon
                        src="sap-icon://action-settings"
                        class="srtSectionIcon"
                    />

                    <Title
                        text="Selective Refresh Parameters"
                        level="H2"
                        class="srtSectionTitle"
                    />
                </HBox>

                <HBox
                    class="srtParameterRow"
                    alignItems="Start"
                >
                    <!-- GROUP ID -->
                    <VBox class="srtField srtFieldGroup">
                        <Label
                            text="Group Id"
                            required="true"
                            class="srtFieldLabel"
                        />

                        <Select
                            id="groupIdSelect"
                            width="50%"
                            selectedKey="{wizard>/groupId}"
                            change="onGroupIdChange"
                            items="{
        path: '/ZRI_GRPID_VH'
    }"
                        >
                            <core:Item
                                key="{GrpId}"
                                text="{GrpId} - {Description}"
                            />
                        </Select>
                    </VBox>

                    <!-- PROCESS ID -->
                    <!-- <VBox class="srtField">
                        <Label
                            text="Process Id"
                            class="srtFieldLabel"
                        />

                        <HBox>
                            <Input
                                id="processIdInput"
                                width="50%"
                                placeholder="Enter Process Id"
                                value="{wizard>/processId}"
                            />

                            <core:Icon
                                src="sap-icon://message-information"
                                class="srtInfoIcon"
                            />
                        </HBox>
                    </VBox> -->

                    <!-- RFC DESTINATION -->
                    <VBox class="srtField">
                        <Label
                            text="RFC Destination"
                            required="true"
                            class="srtFieldLabel"
                        />

                        <Select
                            id="rfcDestinationSelect"
                            width="50%"
                            selectedKey="{wizard>/rfcDestination}"
                        >
                            <items>
                                <core:Item
                                    key="T30CLNT700"
                                    text="T30CLNT700"
                                />
                            </items>
                        </Select>
                    </VBox>
                
           
                   

                    
                </HBox>

                <HBox class="srtDashedLine" />
            </VBox>

            <!-- ================= SELECTION CRITERIA ================= -->
            <!-- ================= SELECTION CRITERIA ================= -->
            <VBox class="srtContentCard">
               <HBox
    class="srtSectionTitleRow"
    alignItems="Center"
    justifyContent="SpaceBetween"
    width="100%"
>
    <!-- LEFT: TITLE -->
    <HBox alignItems="Center">
        <core:Icon
            src="sap-icon://filter"
            class="srtSectionIcon"
        />

        <Title
            text="Selection Criteria"
            level="H2"
            class="srtSectionTitle"
        />
    </HBox>

    <!-- RIGHT: COPY OPTIONS -->
    <HBox alignItems="Center" class="srtCopyOptions">
        <CheckBox
            id="copyAgainSwitch"
            text="Copy Again"
            selected="{wizard>/copyAgain}"
            enabled="{wizard>/copyAgainEnabled}"
        />

        <CheckBox
            id="copyLossSwitch"
            text="Copy Loss"
            selected="{wizard>/copyLoss}"
        />

        <CheckBox
            id="copyAccSwitch"
            text="Copy Account"
            selected="{wizard>/copyAccount}"
        />

        <CheckBox
            id="copyTcrSwitch"
            text="Copy TCR"
            selected="{wizard>/copyTcr}"
        />

        <CheckBox
            id="copyRipSwitch"
            text="Copy RIP"
            selected="{wizard>/copyRip}"
        />
    </HBox>
</HBox>

                <!-- Dynamic object-specific filters -->
                <VBox
                    id="selectionCriteriaContainer"
                    class="srtFilterContainer"
                />

                <VBox
                    id="resultTableContainer"
                    width="100%"
                    visible="false"
                />

                <!-- INFO MESSAGE -->
                <HBox
                    class="srtInfoMessage"
                    alignItems="Center"
                >
                    <core:Icon
                        src="sap-icon://message-information"
                        class="srtInfoMessageIcon"
                    />

                    <Text
                        text="Enter values based on the key field for the selected object."
                        class="srtInfoMessageText"
                    />
                </HBox>
            </VBox>

            <!-- ================= FOOTER ACTIONS ================= -->
            <VBox class="srtActionCard">
                <HBox
                    justifyContent="End"
                    alignItems="Center"
                    class="srtActionRow"
                >
                    <Button
                        text="Clear"
                        icon="sap-icon://decline"
                        type="Transparent"
                        press="onCancel"
                        class="srtOutlineButton srtCancelButton"
                    />

                    <Button
                        text="Execute"
                        icon="sap-icon://navigation-right-arrow"
                        iconFirst="false"
                        type="Unstyled"
                        press="onNext"
                        class="srtNextButton"
                    />
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
