<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="accountCopyWithDialog"
        title="Copy Account With"
        contentWidth="25rem"
        draggable="true"
        resizable="false"
        >

        <content>

            <VBox
                 width="auto"
    class="sapUiSmallMargin">

                <!-- TARGET SYSTEM -->
                <VBox
                    width="100%"
                    class="sapUiSmallMarginBottom">

                    <Label
                        text="Target System"
                        labelFor="rfcDest" />

                    <ComboBox
                        id="rfcDest"
                        width="100%"
                        selectedKey="{wizard>/rfcDestination}"
                        items="{ZRI_SB_RIP_DATA>/RFC}">

                        <core:Item
                            key="{ZRI_SB_RIP_DATA>rfcdest}"
                            text="{ZRI_SB_RIP_DATA>rfcdest}" />

                    </ComboBox>

                </VBox>


                <!-- TREATY FROM -->
                <VBox
                    width="100%"
                    class="sapUiSmallMarginBottom">

                    <Label
                        text="Treaty From"
                        labelFor="copyWithTreatyFrom" />

                    <Input
                        id="copyWithTreatyFrom"
                        value="{wizard>/copyWithTreatyFrom}"
                        width="100%" />

                </VBox>


                <!-- TREATY TO -->
                <VBox
                    width="100%"
                    class="sapUiSmallMarginBottom">

                    <Label
                        text="Treaty To"
                        labelFor="copyWithTreatyTo" />

                    <Input
                        id="copyWithTreatyTo"
                        value="{wizard>/copyWithTreatyTo}"
                        width="100%" />

                </VBox>


                <!-- COPY AGAIN -->
                <VBox
                    width="100%"
                    class="sapUiSmallMarginBottom">

                    <Label
                        text="Copy Again"
                        labelFor="copyWithCopyAgain" />

                    <CheckBox
                        id="copyWithCopyAgain"
                        selected="{wizard>/copyWithCopyAgain}" />

                </VBox>

            </VBox>

        </content>


        <beginButton>
            <Button
                text="Copy Account With"
                type="Emphasized"
                press="onCopyAccountWithExecute" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCopyAccountWithCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>