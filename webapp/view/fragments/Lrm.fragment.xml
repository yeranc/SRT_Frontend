<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="srtFilterContainer">

        <!-- HEADER -->
        <HBox
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiTinyMarginBottom">

            <HBox alignItems="Center">
                <core:Icon
                    src="sap-icon://filter"
                    size="1.4rem"
                    class="srtSectionIcon" />

                <Title
                    text="Selection Criteria"
                    level="H3"
                    class="srtSectionTitle" />
            </HBox>

            <HBox
                alignItems="Center"
                wrap="Wrap">

                

                <CheckBox
                    text="Copy LRM"
                    selected="{wizard>/copyLrm}"
                    class="sapUiTinyMarginEnd" />

                <Button
                    id="accountCopywith"
                    text="Copy LRM with"
                    type="Transparent"
                    press="onAccountCopyWithOpen"
                />

            </HBox>

        </HBox>


        <!-- FILTERS -->
        <HBox
            wrap="Wrap"
            alignItems="End"
            class="srtFilterRow"
            justifyContent="Start">

            <!-- Policy ID -->
            <VBox class="srtFilterField">
                <Label text="Policy ID" />
                <Input
                    id="lrmPolicyId"
                    value="{wizard>/lrmPolicyId}"
                    placeholder="Enter Policy ID"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Policy Number -->
            <VBox class="srtFilterField">
                <Label text="Policy Number" />
                <Input
                    id="lrmPolicyNumber"
                    value="{wizard>/lrmPolicyNumber}"
                    placeholder="Enter Policy Number"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Process Ref ID -->
            <VBox class="srtFilterField">
                <Label text="Process Ref ID" />
                <Input
                    id="lrmProcessRefId"
                    value="{wizard>/lrmProcessRefId}"
                    placeholder="Enter Process Ref ID"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Cedent -->
            <VBox class="srtFilterField">
                <Label text="Cedent" />
                <Input
                    id="lrmCedent"
                    value="{wizard>/lrmCedent}"
                    placeholder="Enter Cedent"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Company Code -->
            <VBox class="srtFilterField">
                <Label text="Company Code" />
                <Input
                    id="lrmCompanyCode"
                    value="{wizard>/lrmCompanyCode}"
                    placeholder="Enter Company Code"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Treaty Number -->
            <VBox class="srtFilterField">
                <Label text="Treaty Number" />
                <Input
                    id="lrmTreatyNumber"
                    value="{wizard>/lrmTreatyNumber}"
                    placeholder="Enter Treaty Number"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Ident ID -->
            <VBox class="srtFilterField">
                <Label text="Ident ID" />
                <Input
                    id="lrmIdentId"
                    value="{wizard>/lrmIdentId}"
                    placeholder="Enter Ident ID"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Life ID -->
            <VBox class="srtFilterField">
                <Label text="Life ID" />
                <Input
                    id="lrmLifeId"
                    value="{wizard>/lrmLifeId}"
                    placeholder="Enter Life ID"
                    showValueHelp="true"
                    valueHelpRequest="onLrmValueHelp"
                    submit="onLRMGo" />
            </VBox>

            <!-- Search -->
            <Button
                text="Go"
                type="Emphasized"
                class="srtFilterGoButton"
                press="onLRMGo" />

        </HBox>

    </VBox>

</core:FragmentDefinition>