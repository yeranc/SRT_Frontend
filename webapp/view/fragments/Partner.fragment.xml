<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="srtFilterContainer">

        <!-- HEADER -->
        <HBox
            width="100%"
            alignItems="Center"
            justifyContent="Start"
            class="sapUiTinyMarginBottom">

            <HBox alignItems="Center">
                <core:Icon
                    src="sap-icon://filter"
                    size="1.4rem"
                    class="srtSectionIcon" />

                <Title
                    text="Selection Criteria"
                    level="H3"
                    class="srtSectionTitle" />
            </HBox>

        </HBox>


        <!-- FILTER ROW -->
        <HBox
            width="100%"
            alignItems="End"
            justifyContent="Start"
            wrap="Wrap"
            class="srtFilterRow">

            <!-- Business Partner -->
            <VBox width="20rem">
                <Label
                    text="Business Partner"
                    class="srtFieldLabel" />

                <Input
                    id="businessPartnerInput"
                    width="100%"
                    value="{wizard>/businessPartner}"
                    placeholder="Enter Business Partner"
                    showValueHelp="true"
                    valueHelpRequest="onBusinessPartnerValueHelp" />
            </VBox>


            <ToolbarSpacer width="2rem" />


            <!-- Process Ref ID -->
            <VBox width="20rem">
                <Label
                    text="Process Ref ID"
                    class="srtFieldLabel" />

                <Input
                    id="processRefIdInput"
                    width="100%"
                    value="{wizard>/processRefId}"
                    placeholder="Enter Process Ref ID" />
            </VBox>


            <ToolbarSpacer width="2rem" />


            <!-- Target System -->
            <VBox width="20rem">
                <Label
                    text="Target System"
                    class="srtFieldLabel" />

                <ComboBox
                    id="rfcDestination"
                    width="100%"
                    selectedKey="{wizard>/rfcDestination}"
                    items="{ZRI_SB_RIP_DATA>/RFC}"
                    showSecondaryValues="false">

                    <core:Item
                        key="{ZRI_SB_RIP_DATA>rfcdest}"
                        text="{ZRI_SB_RIP_DATA>rfcdest}" />

                </ComboBox>
            </VBox>


            <ToolbarSpacer width="2rem" />


            <!-- Go Button -->
            <VBox width="5rem">

                <Label
                    text=" "
                    class="srtFieldLabel" />

                <Button
                    text="Go"
                    type="Emphasized"
                    width="100%"
                    press="onBPGo" />

            </VBox>

        </HBox>

    </VBox>

</core:FragmentDefinition>