<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>

    <HBox
        width="100%"
        alignItems="End"
        justifyContent="Start"
    >

        <!-- Business Partner -->
        <VBox width="20rem">
            <Label
                text="Business Partner"
                class="srtFieldLabel"
            />

            <Input
                id="businessPartnerInput"
                width="100%"
                value="{wizard>/businessPartner}"
                placeholder="Enter Business Partner"
                showValueHelp="true"
                valueHelpRequest="onBusinessPartnerValueHelp"
            />
        </VBox>


        <!-- Space -->
        <ToolbarSpacer width="2rem" />


        <!-- Process Ref ID -->
        <VBox width="20rem">
            <Label
                text="Process Ref ID"
                class="srtFieldLabel"
            />

            <Input
                id="processRefIdInput"
                width="100%"
                value="{wizard>/processRefId}"
                placeholder="Enter Process Ref ID"
                showValueHelp="true"
                valueHelpRequest="onProcessRefIdValueHelp"
            />
        </VBox>


        <!-- Space -->
        <ToolbarSpacer width="2rem" />


        <!-- Target System -->
        <VBox width="20rem">
            <Label
                text="Target System"
                class="srtFieldLabel"
            />

            <Input
                id="targetSystemInput"
                width="100%"
                value="{wizard>/targetSystem}"
                placeholder="Enter Target System"
                showValueHelp="true"
                valueHelpRequest="onTargetSystemValueHelp"
            />
        </VBox>


        <!-- Space -->
        <ToolbarSpacer width="2rem" />


        <!-- Go Button -->
        <VBox width="5rem">
            <Label
                text=" "
                class="srtFieldLabel"
            />

            <Button
                text="Go"
                type="Emphasized"
                width="100%"
                press="onBPGo"
            />
        </VBox>

    </HBox>

</core:FragmentDefinition>