<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="processLogDialog"
        contentWidth="75rem"
        verticalScrolling="false"
        resizable="true"
        draggable="true"
        class="srtProcessLogDialog">

        <customHeader>
            <Toolbar class="srtProcessLogHeader">
                <Title text="Process Log" level="H3"/>
            </Toolbar>
        </customHeader>

        <content>
            <ScrollContainer
                height="28rem"
                width="100%"
                vertical="true"
                horizontal="false">

                <Table
                    id="processLogTable"
                    items="{processLog>/logs}"
                    width="100%"
                    sticky="ColumnHeaders"
                    growing="true"
                    growingThreshold="50"
                    growingScrollToLoad="false"
                    updateFinished=".onProcessLogUpdateFinished">

                    <columns>
                        <Column><Text text="Process Ref ID"/></Column>
                        <Column><Text text="Object Type"/></Column>
                        <Column><Text text="Source Object"/></Column>
                        <Column><Text text="Message Type"/></Column>
                        <Column width="25rem"><Text text="Message"/></Column>
                        <Column><Text text="Created Object"/></Column>
                        <Column><Text text="Target System"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{processLog>ProcessingId}"/>
                                <Text text="{processLog>ObjectType}"/>
                                <Text text="{processLog>SourceNumber}"/>
                                <Text text="{processLog>Type}"/>
                                <Text text="{processLog>Message}" wrapping="true"/>
                                <Text text="{processLog>TargetNumber}"/>
                                <Text text="{processLog>Systemm}"/>
                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </ScrollContainer>
        </content>

        <endButton>
            <Button text="Close" press="onProcessLogClose"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>