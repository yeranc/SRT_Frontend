<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <VBox class="srtFilterContainer">
        <!-- HEADER -->
        <HBox
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiTinyMarginBottom"
        >
            <HBox alignItems="Center">
                <core:Icon
                    src="sap-icon://filter"
                    size="1.4rem"
                    class="srtSectionIcon"
                />

                <Title
                    text="Selection Criteria"
                    level="H3"
                    class="srtSectionTitle"
                />
            </HBox>

            <HBox
                alignItems="Center"
                wrap="Wrap"
            >
                <Button
                    text="Process Log"
                    type="Transparent"
                    press="onProcessLogPress"
                    class="sapUiTinyMarginEnd"
                />
                <CheckBox
                    id="copyAccs"
                    text="Copy Account"
                    selected="{wizard>/copyAccount}"
                    
                />
            </HBox>
        </HBox>

        <!-- RAM FILTER ROW -->
        <HBox
            class="srtFilterRow"
            width="100%"
            wrap="NoWrap"
            alignItems="End"
            justifyContent="Start"
        >
            <!-- EXTERNAL SYSTEM ID -->
            <VBox class="srtFilterField">
                <Label
                    text="External System ID"
                    class="srtFieldLabel"
                />

                <Input
                    value="{wizard>/ramExternalSystemId}"
                    placeholder="External System ID"
                    submit="onRAMGo"
                />
            </VBox>

            <!-- EXTERNAL ID -->
            <VBox class="srtFilterField">
                <Label
                    text="External ID"
                    class="srtFieldLabel"
                />

                <Input
                    value="{wizard>/ramExternalId}"
                    placeholder="External ID"
                    submit="onRAMGo"
                />
            </VBox>

            <!-- PROCESS REF ID -->
            <VBox class="srtFilterField">
                <Label
                    text="Process Ref ID"
                    class="srtFieldLabel"
                />

                <Input
                    value="{wizard>/ramProcessRefId}"
                    placeholder="Process Ref ID"
                    submit="onRAMGo"
                />
                
            </VBox>

            <!-- TARGET RAM -->
            <VBox class="srtFilterField">
                <Label
                    text="Target RAM"
                    class="srtFieldLabel"
                />

                <Input
                    value="{wizard>/ramTargetRam}"
                    placeholder="Target RAM"
                    submit="onRAMGo"
                />
            </VBox>

            <!-- TARGET SYSTEM -->
            <VBox class="srtFilterField">
                <Label
                    text="Target System"
                    class="srtFieldLabel"
                />

                <Input
                    value="{wizard>/ramTargetSystem}"
                    placeholder="Target System"
                    submit="onRAMGo"
                />
            </VBox>

            <!-- GO -->
            <Button
                text="Go"
                type="Emphasized"
                press="onRAMGo"
                class="srtGoButton"
            />
        </HBox>
    </VBox>
</core:FragmentDefinition>
