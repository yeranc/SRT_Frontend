<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="srtFilterContainer">

        <!-- HEADER -->
        <HBox
            width="100%"
            justifyContent="SpaceBetween"
            alignItems="Center"
            class="sapUiTinyMarginBottom">

            <HBox alignItems="Center">
                <core:Icon
                    src="sap-icon://filter"
                    size="1.4rem"
                    class="srtSectionIcon" />

                <Title
                    text="Selection Criteria"
                    level="H3"
                    class="srtSectionTitle" />
            </HBox>

            <HBox
                alignItems="Center"
                wrap="Wrap">

                <CheckBox
                    text="Copy Again"
                    selected="{wizard>/copyAgain}"
                    enabled="{wizard>/copyAgainEnabled}"
                    class="sapUiTinyMarginEnd" />

                <CheckBox
                    text="Copy Loss"
                    selected="{wizard>/copyLoss}"
                    class="sapUiTinyMarginEnd" />

                <CheckBox
                    text="Copy Account"
                    selected="{wizard>/copyAccount}"
                    class="sapUiTinyMarginEnd" />


            </HBox>

        </HBox>


        <!-- RIP FILTER ROW -->
        <HBox
            class="srtFilterRow"
            wrap="Wrap"
            alignItems="End"
            justifyContent="Start">


            <!-- RIP NUMBER -->
            <VBox class="srtFilterField">

                <Label
                    text="RIP Number"
                    class="srtFieldLabel" 
                    />

                <Input
                    id="ripNumberInput"
                    value="{wizard>/ripNumber}"
                    placeholder="Enter RIP Number"
                    showValueHelp="true"
                    valueHelpRequest="onRIPValueHelp" />

            </VBox>


            <!-- CREATED BY -->
            <VBox class="srtFilterField">

                <Label
                    text="Created By"
                    class="srtFieldLabel" />

                <Input
                    value="{wizard>/ripCreatedBy}"
                    placeholder="Enter Created By" />

            </VBox>


            <!-- CREATION DATE -->
            <VBox class="srtFilterField">

                <Label
                    text="Creation Date"
                    class="srtFieldLabel" />

                <DatePicker
                    value="{wizard>/ripCreationDate}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd.MM.yyyy"
                    placeholder="Select Date" />

            </VBox>


            <!-- PROCESS REF ID -->
            <VBox class="srtFilterField">

                <Label
                    text="Process Ref ID"
                    class="srtFieldLabel" />

                <Input
                    value="{wizard>/ripProcessRefId}"
                    placeholder="Enter Process Ref ID" />

            </VBox>


            <Button
                text="Go"
                type="Emphasized"
                press="onRIPGo"
                class="srtGoButton" />

        </HBox>

    </VBox>

</core:FragmentDefinition>